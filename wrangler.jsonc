{
  // Cloudflare Worker that serves the built Vite output (dist/) plus a small Hono
  // router for server-side routes. Domain: the default *.workers.dev subdomain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquid-glass-ux",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    // Produced by `vite build` (see package.json scripts).
    "directory": "./dist",
    // Exposes the static asset manifest to the Worker as env.ASSETS.
    "binding": "ASSETS",
    // Unknown paths fall back to index.html (SPA routing).
    "not_found_handling": "single-page-application",
    // These paths bypass the asset server and are handled by the Hono Worker.
    // Without this, /healthz would be answered with index.html.
    "run_worker_first": ["/healthz", "/api/*"]
  }
}
